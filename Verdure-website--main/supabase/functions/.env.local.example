# Secrets for the waitlist-notify Edge Function.
#
# Copy to .env.local (gitignored by supabase/.gitignore) for local runs:
#   npm run supabase:serve
#
# For the hosted project these same four are set with `supabase secrets set`,
# NOT from this file — see the deploy step. Nothing here is read at build time
# or reaches the browser; the function runs on Supabase's edge runtime.

# Must match the value stored in Postgres Vault as `waitlist_notify_secret`.
# Generate once with:  openssl rand -base64 32
# If these two ever drift, every call returns 404, no mail is sent, and the
# trigger swallows the failure — so rotate both together or neither.
WAITLIST_NOTIFY_SECRET=

# Resend → API Keys. Sending permission is all it needs.
RESEND_API_KEY=

# Where the notification lands.
NOTIFY_TO=

# Must be on a domain verified in Resend, or every send is rejected with a 422
# that only appears in the function logs.
NOTIFY_FROM=Verdure <notify@verdure-app.com>
