# Supabase — Project Settings → API
# Copy this file to .env.local and fill in the two values from your project.
# Both are PUBLIC (safe for the browser): the anon key is gated by Row Level
# Security. Never put the service_role key in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Waitlist/auth still use the anon key. Support and interest submissions are
# private; their server routes and Firebase-authorized staff inbox require a
# SERVER-ONLY service-role key. Never use a NEXT_PUBLIC_ prefix for it.
# SUPABASE_SERVICE_ROLE_KEY=
# VERDURE_SUBMISSIONS_SUPABASE_URL=     # optional separate URL; otherwise uses the public URL above
# VERDURE_SUBMISSIONS_LOCAL=1          # development only; refuses non-loopback Supabase

# Used to build absolute auth-redirect URLs (e.g. the email confirmation link).
# Local dev: http://localhost:3000 — Production: your deployed origin.
#
# REQUIRED IN PRODUCTION. src/app/auth/actions.ts falls back to
# http://localhost:3000 when this is unset, which means every confirmation
# email sent from the deployed site would point new users at their own
# machine and no account could ever be confirmed. Set it to
# https://verdure-app.com before enabling auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — Google Search Console's HTML-tag verification method. Paste only
# the `content` value from the meta tag Google shows you, not the whole tag.
# Leave it unset if you verify by DNS TXT record instead, which is the better
# option here: it survives a redeploy and covers every subdomain at once.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional. Base URL of the Verdure Cloud Functions behind the /remove page
# (requestSourceRemoval and removalToken in functions/src/discovery/removal.ts).
#   Production: https://us-central1-connectify-19dd8.cloudfunctions.net
#   Emulator:   http://127.0.0.1:5001/connectify-19dd8/us-central1
# Leave it unset and /remove renders a notice instead of the form.
# NEXT_PUBLIC_VERDURE_FUNCTIONS_URL=
