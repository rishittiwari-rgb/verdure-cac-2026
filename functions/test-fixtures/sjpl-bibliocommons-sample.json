    "definition": {
     "start": "2026-09-20T15:30",
     "end": "2026-09-20T16:30",
     "title": "OneInMath: Math Support for Grades K\u20133 at Joyce Ellington Branch",
     "description": "<p>Build confidence and strengthen math skills in this free program for students in kindergarten through third grade.&nbsp;Students will receive individualized support from trained volunteers while working through engaging math activities, games, and lessons designed to reinforce foundational math concepts. Student can progress at their own pace in a welcoming and supportive learning environment.<br></p>\n<h4>Registration is required.</h4>\n<p>Visit the <a href=\"https://oneinmath.com/register/\" target=\"_blank\" rel=\"noreferrer noopener\">One in Math website to register.</a>&nbsp;</p>\n<p>You may be asked to provide personal information to sign-up. Please review <a href=\"https://oneinmath.com/privacy-policy/\" target=\"_blank\" rel=\"noreferrer noopener\">One in Math\u2019s Privacy Policy</a> before registering.</p>\n<hr>\n<p><a href=\"https://www.sjpl.org/ada-event-accommodation/\">Request an ADA accommodations for this event</a>.<br></p>",
     "partnerId": null,
     "bibIds": [],
