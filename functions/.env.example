# Non-secret function configuration.
#
# WHY THIS FILE EXISTS: firebase-functions `defineString()` params PROMPT
# INTERACTIVELY for a value when none is supplied — including under
# `emulators:exec`, which made `npm run e2e` hang forever waiting on stdin the
# first time config params were introduced. That turns a CI job into a silent
# timeout rather than a failure, which is worse than a broken test.
#
# Declaring the defaults here keeps the emulator and CI non-interactive. These
# are deliberately the SAFE values: sandbox endpoints and empty ids, so a
# misconfigured deploy sends nothing and charges nothing rather than hitting
# production by accident.
#
# SECRETS DO NOT BELONG HERE. API keys go through `firebase functions:secrets:set`
# and are bound per-function via `defineSecret`. Anything in this file is
# committed to the repo.

# ── Tremendous (gift cards) ──
# Flip to `production` only once a funded live account and real product ids exist.
TREMENDOUS_ENV=sandbox
# Optional: a campaign id lets recipients choose a brand when a reward has no
# explicit Tremendous product id mapped in the TREMENDOUS_CATALOG secret.
TREMENDOUS_CAMPAIGN_ID=

# ── Apple / Verdure+ ──
APPLE_BUNDLE_ID=com.verdure-app.verdure
# Numeric App Store id. REQUIRED before switching APPLE_IAP_ENVIRONMENT to
# production — the notification verifier demands it there.
APPLE_APP_APPLE_ID=
# `sandbox` until the app is live; controls which Apple environment is tried first.
APPLE_IAP_ENVIRONMENT=sandbox

# ── Adventure Planner — the model name, used ONLY when ANTHROPIC_API_KEY is configured (the rules engine needs none) ──
ADVENTURE_MODEL=claude-sonnet-5
