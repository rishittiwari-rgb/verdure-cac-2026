rules_version = '2';

// Verdure Cloud Storage rules.
// Images only, size-capped, owner-scoped writes, public read.
service firebase.storage {
  match /b/{bucket}/o {

    // Profile pictures: /profilePics/{uid}.jpg — only the owner writes; anyone can read.
    match /profilePics/{userId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && isImageUnder(5);
    }

    // Proof-of-attendance photos: /proofs/{uid}/{eventId}.jpg — owner-only read/write.
    match /proofs/{userId}/{photoId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && isImageUnder(8);
    }

    // Everything else denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isImageUnder(maxMB) {
      return request.resource.size < maxMB * 1024 * 1024
             && request.resource.contentType.matches('image/.*');
    }
  }
}
