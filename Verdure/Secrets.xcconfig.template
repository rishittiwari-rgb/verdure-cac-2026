// Secrets.xcconfig.template — Copy to Secrets.xcconfig and fill in your values
// Get SerpApi key from https://serpapi.com
// Get Firebase values from your GoogleService-Info.plist (Firebase Console)

FIREBASE_API_KEY = your_firebase_api_key_here
FIREBASE_GCM_SENDER_ID = your_gcm_sender_id_here
FIREBASE_PROJECT_ID = your_firebase_project_id_here
FIREBASE_STORAGE_BUCKET = your_firebase_storage_bucket_here
FIREBASE_GOOGLE_APP_ID = your_firebase_google_app_id_here

// ── External event providers (optional; blank = provider disabled) ──
// Ticketmaster Discovery — free key: https://developer.ticketmaster.com
// Eventbrite — private token + your org id (public search is retired):
//   https://www.eventbrite.com/platform/api
// Localist — your institution's calendar host, e.g. calendar.your-school.edu
//   https://developer.localist.com/doc/api
// Google Programmable Search (Custom Search JSON API) — API key + engine id (cx):
//   https://developers.google.com/custom-search/v1/overview
// Neighborhood Commons — UNVERIFIED endpoint; set base URL + key if it exists:

// ── More free providers (added 2026-06) ──
// SeatGeek events — free client_id (2 min): https://seatgeek.com/build
// National Park Service — free key: https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY = your_nps_api_key
// Recreation.gov RIDB — free key: https://ridb.recreation.gov/ (Sign Up → API key)
RECREATION_GOV_KEY = your_recreation_gov_key
