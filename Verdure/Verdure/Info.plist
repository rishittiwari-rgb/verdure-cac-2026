<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Verdure</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>verdure</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>FirebaseCrashlyticsCollectionEnabled</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Verdure uses the camera only when you open Explore view (beta), to display nearby labels over a live preview. No preview frames are stored or transmitted.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Only if you enable nearby deal alerts, Verdure uses background region monitoring to notify you as you walk near a participating partner. This is optional and can be switched off in Notifications.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Verdure uses your location to find nearby events and outdoor places you can check in to.</string>
	<key>NSMotionUsageDescription</key>
	<string>Verdure uses motion to gently tilt cards as you move your phone. This is purely decorative and no motion data ever leaves your device.</string>
	<key>NpsApiKey</key>
	<string>$(NPS_API_KEY)</string>
	<key>RecreationGovKey</key>
	<string>$(RECREATION_GOV_KEY)</string>
	<key>UIAppFonts</key>
	<array>
		<string>Rubik-Light.ttf</string>
		<string>Rubik-Regular.ttf</string>
		<string>Rubik-Medium.ttf</string>
		<string>Rubik-SemiBold.ttf</string>
		<string>Rubik-Bold.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations~iphone</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
